<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.NihongoDictionary" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#141218</item>
        <item name="android:statusBarColor">#141218</item>
        <item name="android:navigationBarColor">#141218</item>
    </style>

    <!-- SplashScreen Starting Theme: Only shows the clean icon in the center -->
    <style name="Theme.NihongoDictionary.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#141218</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.NihongoDictionary</item>
    </style>
</resources>
